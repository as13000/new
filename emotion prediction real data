        "#TRAIN SHEET\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import LabelEncoder\n",
        "from sklearn.ensemble import RandomForestClassifier, RandomForestRegressor\n",
        "from sklearn.metrics import (accuracy_score, classification_report,\n",
        "                             confusion_matrix, ConfusionMatrixDisplay,\n",
        "                             mean_absolute_error, mean_squared_error)\n",
        "from sklearn.feature_extraction.text import TfidfVectorizer\n",
        "from scipy.sparse import hstack, csr_matrix\n",
        "\n",
        "ROWS = 1200\n",
        "COLUMNS = 13\n",
        "\n",
        "train_url = \"https://docs.google.com/spreadsheets/d/1yLDum7yWr3IH0KivluCBEvqHGlfvFW_S/edit?gid=1732878339\"\n",
        "sheet_id = train_url.split(\"/d/\")[1].split(\"/\")[0]\n",
        "gid = train_url.split(\"gid=\")[1]\n",
        "csv_url = f\"https://docs.google.com/spreadsheets/d/{sheet_id}/export?format=csv&gid={gid}\"\n",
        "\n",
        "df = pd.read_csv(csv_url)\n",
        "print(\"Original Shape:\", df.shape)\n",
        "\n",
        "df['sleep_hours']       = df['sleep_hours'].fillna(df['sleep_hours'].mean())\n",
        "df['face_emotion_hint'] = df['face_emotion_hint'].fillna('none')\n",
        "df['previous_day_mood'] = df['previous_day_mood'].fillna(df['previous_day_mood'].mode()[0])\n",
        "df['journal_text']      = df['journal_text'].fillna('')\n",
        "\n",
        "le_emotion = LabelEncoder()\n",
        "y_emotion   = le_emotion.fit_transform(df['emotional_state'])\n",
        "y_intensity = df['intensity'].values\n",
        "\n",
        "\n",
        "cat_columns = [\n",
        "    'ambience_type', 'previous_day_mood',\n",
        "    'face_emotion_hint', 'reflection_quality', 'time_of_day'\n",
        "]\n",
        "X_struct = pd.get_dummies(\n",
        "    df.drop(columns=['emotional_state', 'intensity', 'journal_text']),\n",
        "    columns=cat_columns,\n",
        "    drop_first=True\n",
        ").astype(np.float32)\n",
        "\n",
        "tfidf = TfidfVectorizer(max_features=200, stop_words='english', ngram_range=(1, 2))\n",
        "X_text = tfidf.fit_transform(df['journal_text'])\n",
        "\n",
        "X_combined = hstack([csr_matrix(X_struct.values), X_text])\n",
        "\n",
        "X_train, X_test, \\\n",
        "y_train_e, y_test_e, \\\n",
        "y_train_i, y_test_i = train_test_split(\n",
        "    X_combined, y_emotion, y_intensity,\n",
        "    test_size=0.2, random_state=42, stratify=y_emotion\n",
        ")\n",
        "\n",
        "model_emotion = RandomForestClassifier(\n",
        "    n_estimators=500,\n",
        "    max_depth=20,\n",
        "    min_samples_split=5,\n",
        "    class_weight='balanced',\n",
        "    random_state=42,\n",
        "    n_jobs=-1\n",
        ")\n",
        "model_emotion.fit(X_train, y_train_e)\n",
        "y_pred_e = model_emotion.predict(X_test)\n",
        "\n",
        "acc = accuracy_score(y_test_e, y_pred_e)\n",
        "print(f\"\\n Emotion Accuracy: {acc*100:.2f}%\")\n",
        "print(classification_report(y_test_e, y_pred_e, target_names=le_emotion.classes_))\n",
        "\n",
        "model_intensity = RandomForestRegressor(\n",
        "    n_estimators=300,\n",
        "    random_state=42,\n",
        "    n_jobs=-1\n",
        ")\n",
        "model_intensity.fit(X_train, y_train_i)\n",
        "y_pred_i = model_intensity.predict(X_test)\n",
        "\n",
        "mae  = mean_absolute_error(y_test_i, y_pred_i)\n",
        "rmse = np.sqrt(mean_squared_error(y_test_i, y_pred_i))\n",
        "\n",
        "\n",
        "y_pred_i_rounded = np.clip(np.round(y_pred_i).astype(int), 1, 5)\n",
        "print(f\" Rounded Accuracy (exact match): {accuracy_score(y_test_i, y_pred_i_rounded)*100:.2f}%\")\n",
        "\n",
        "\n",
        "\n",
        "#TEST SHEET\n",
        "\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from scipy.sparse import hstack, csr_matrix\n",
        "\n",
        "\n",
        "test_url  = \"https://docs.google.com/spreadsheets/d/1lCvTufEhGgtDJp6b9oYyFXpCZqWPirSX/edit?usp=sharing\"\n",
        "test_id   = test_url.split(\"/d/\")[1].split(\"/\")[0]\n",
        "test_csv  = f\"https://docs.google.com/spreadsheets/d/{test_id}/export?format=csv\"\n",
        "\n",
        "df_test = pd.read_csv(test_csv)\n",
        "print(\" Test shape  :\", df_test.shape)\n",
        "print(\" Columns     :\", df_test.columns.tolist())\n",
        "display(df_test.head())\n",
        "\n",
        "df_test['sleep_hours']       = df_test['sleep_hours'].fillna(df_test['sleep_hours'].mean())\n",
        "df_test['face_emotion_hint'] = df_test['face_emotion_hint'].fillna('none')\n",
        "df_test['previous_day_mood'] = df_test['previous_day_mood'].fillna(df_test['previous_day_mood'].mode()[0])\n",
        "df_test['journal_text']      = df_test['journal_text'].fillna('')\n",
        "\n",
        "print(\"Nulls after cleaning:\\n\", df_test.isnull().sum())\n",
        "\n",
        "cat_columns = [\n",
        "    'ambience_type', 'previous_day_mood',\n",
        "    'face_emotion_hint', 'reflection_quality', 'time_of_day'\n",
        "]\n",
        "\n",
        "drop_cols = [c for c in ['emotional_state', 'intensity', 'journal_text']if c in df_test.columns]\n",
        "\n",
        "X_test_struct = pd.get_dummies(\n",
        "    df_test.drop(columns=drop_cols),\n",
        "    columns=cat_columns,\n",
        "    drop_first=True\n",
        ").astype(np.float32)\n",
        "\n",
        "for col in X_struct.columns:\n",
        "    if col not in X_test_struct.columns:\n",
        "        X_test_struct[col] = 0.0\n",
        "X_test_struct = X_test_struct[X_struct.columns]\n",
        "\n",
        "\n",
        "X_test_text     = tfidf.transform(df_test['journal_text'])\n",
        "X_test_combined = hstack([csr_matrix(X_test_struct.values), X_test_text])\n",
        "\n",
        "print(\" Test feature shape :\", X_test_combined.shape)\n",
        "\n",
        "y_pred_emotion   = model_emotion.predict(X_test_combined)\n",
        "emotion_labels   = le_emotion.inverse_transform(y_pred_emotion)\n",
        "emotion_probas   = model_emotion.predict_proba(X_test_combined)\n",
        "emotion_conf     = emotion_probas.max(axis=1).round(3)\n",
        "\n",
        "y_pred_intensity = model_intensity.predict(X_test_combined)\n",
        "intensity_vals   = np.clip(np.round(y_pred_intensity).astype(int), 1, 5)\n",
        "\n",
        "print(\"Sample predictions:\")\n",
        "for i in range(5):\n",
        "    print(f\"  [{i}] state={emotion_labels[i]:<12} \"\n",
        "          f\"intensity={intensity_vals[i]}  conf={emotion_conf[i]:.2f}\")\n",
        "\n",
        "df_test['emotional_state'] = emotion_labels\n",
        "df_test['intensity']       = intensity_vals\n",
        "df_test['confidence']      = emotion_conf\n",
        "\n",
        "print(\"\\nPrediction distributions:\")\n",
        "print(\"\\nemotional_state:\")\n",
        "print(df_test['emotional_state'].value_counts())\n",
        "print(\"\\nintensity:\")\n",
        "print(df_test['intensity'].value_counts().sort_index())\n",
        "\n",
        "\n",
        "display(df_test[['journal_text','emotional_state','intensity','confidence']].head(15))\n",
        "\n",
        "\n",
        "from openpyxl import load_workbook\n",
        "from openpyxl.styles import PatternFill, Font, Alignment\n",
        "\n",
        "output_path = 'arvyax_test_predictions.xlsx'\n",
        "df_test.to_excel(output_path, index=False)\n",
        "\n",
        "wb = load_workbook(output_path)\n",
        "ws = wb.active\n",
        "\n",
        "green_fill  = PatternFill(start_color=\"C6EFCE\", end_color=\"C6EFCE\", fill_type=\"solid\")\n",
        "yellow_fill = PatternFill(start_color=\"FFEB9C\", end_color=\"FFEB9C\", fill_type=\"solid\")\n",
        "bold_font   = Font(bold=True)\n",
        "\n",
        "headers = [cell.value for cell in ws[1]]\n",
        "pred_cols    = ['emotional_state', 'intensity']\n",
